      "id": "service",
      "path": "slitweb/service.py",
      "responsibility": "串联归约、比对和历史读取"
    },
    {
      "id": "server",
      "path": "slitweb/server.py",
      "responsibility": "本机 HTTP 及静态界面入口"
    },
    {
      "id": "workbench",
      "path": "web/ui.js",
      "responsibility": "页面状态、样例归约、视图切换与图形编排"
    },
    {
      "id": "reconcile",
      "path": "slitweb/reconcile.py",
