    {
      "id": "domain",
      "path": "slitweb/domain.py",
      "responsibility": "解析领域单位与归约事实"
    },
    {
      "id": "rules",
      "path": "slitweb/rules.py",
      "responsibility": "消费归约证据和约束，产生业务判定"
    },
    {
      "id": "artifacts",
      "path": "slitweb/artifacts.py",
      "responsibility": "成果规范编码、摘要与差分"
    },
    {
      "id": "archive",
      "path": "slitweb/archive.py",
      "responsibility": "SQLite 历史版本与原子封存"
